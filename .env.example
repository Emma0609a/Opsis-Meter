# Copia este archivo como .env y completa los valores.

# --- Supabase (historial en la nube) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Modelo de IA (detector de limones) ---
# Ruta al modelo ONNX exportado de YOLO. Si se omite, se usa el primer
# archivo .onnx encontrado en la carpeta models/.
OPSIS_MODELO=models/limones.onnx

# Umbral de confianza mínimo para aceptar una detección (0.0 - 1.0)
OPSIS_CONFIANZA=0.35
